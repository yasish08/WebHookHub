# Copy to .env and configure before starting the API
DATABASE_URL="postgresql://postgres:password@localhost:5432/webhookhub?schema=public"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"
# Generate unique random values for your local environment; never commit real secrets.
JWT_SECRET="replace-with-at-least-32-random-characters"
SECRET_ENCRYPTION_KEY="replace-with-a-different-32-plus-character-random-value"
