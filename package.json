{
  "name": "webhookhub",
  "version": "1.0.0",
  "private": true,
  "description": "Reliable webhook delivery platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n CLIENT,SERVER -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "db:generate": "npm run db:generate --workspace server",
    "db:push": "npm run db:push --workspace server",
    "test": "npm test --workspaces --if-present",
    "worker": "npm run worker --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
